# Copy to .env. Never commit .env or share secrets in chat.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GNANI_API_KEY=
GNANI_STT_LANGUAGE=indic-auto
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=transcribe
GNANI_TTS_VOICE=Shivani
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_LANGUAGE=auto


# Local reasoning loop (Ollama). Raw narration remains on this computer.
REASONING_MODEL=qwen3:4b
REASONING_TIMEOUT_SECONDS=180
REASONING_CONTEXT_TOKENS=8192

# Local RAG (requires Ollama running on this computer and bge-m3 pulled)
RAG_ENABLED=true
RAG_COLLECTION=cybersaathi_knowledge
RAG_DB_PATH=data/qdrant
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_TIMEOUT_SECONDS=90
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Speed settings (local Qwen via Ollama)
# fast = short prompt + short JSON (recommended on a CPU-only laptop); detailed = the long full analysis
REASONING_MODE=fast
REASONING_KEEP_ALIVE=30m
REASONING_NUM_PREDICT_FAST=450
REASONING_CONTEXT_CHARS=1500
